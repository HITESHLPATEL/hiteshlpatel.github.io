{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": {{ site.url | append: "/workshops.json#workshop-list" | jsonify }},
  "name": {{ site.author.name | append: " — Workshop organization" | jsonify }},
  "url": {{ site.url | append: "/service/#academic-service" | jsonify }},
  "numberOfItems": {{ site.data.workshops.size }},
  "itemListElement": [
    {% for workshop in site.data.workshops %}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "item": {
        "@type": "Event",
        "@id": {{ workshop.id | prepend: "/workshops.json#" | prepend: site.url | jsonify }},
        "name": {{ workshop.name | jsonify }},
        "superEvent": { "@type": "Event", "name": {{ workshop.conference | jsonify }} },
        "organizer": {
          "@type": "Role",
          "roleName": {{ workshop.role | jsonify }},
          "url": {{ workshop.role_source | jsonify }},
          "organizer": {
            "@type": "Person",
            "@id": {{ site.url | append: "/#person" | jsonify }},
            "name": {{ site.author.name | jsonify }},
            "url": {{ site.url | append: "/" | jsonify }}
          }
        }
        {% if workshop.url %}, "url": {{ workshop.url | jsonify }}{% endif %}
        {% if workshop.overview %}, "description": {{ workshop.overview | jsonify }},
        "subjectOf": { "@type": "WebPage", "url": {{ workshop.overview_source | jsonify }} }
        {% endif %}
        {% if workshop.topics %}, "keywords": {{ workshop.topics | jsonify }}{% endif %}
        {% if workshop.start_date %}, "startDate": {{ workshop.start_date | jsonify }}{% endif %}
        {% if workshop.location %}, "location": { "@type": "Place", "name": {{ workshop.location | jsonify }} }{% endif %}
      }
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
