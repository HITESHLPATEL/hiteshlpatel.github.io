{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": {{ site.url | append: "/publications/#publication-list" | jsonify }},
  "name": {{ site.author.name | append: " — Publications" | jsonify }},
  "url": {{ site.url | append: "/publications/" | jsonify }},
  "numberOfItems": {{ site.data.publications.size }},
  "itemListElement": [
    {% for publication in site.data.publications %}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "item": {% include publication-schema.json publication=publication with_abstracts=include.with_abstracts %}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
